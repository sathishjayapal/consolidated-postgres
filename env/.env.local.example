# Golden local-dev credentials template.
# Copy to env/.env.local (gitignored) and fill in real values:
#   cp env/.env.local.example env/.env.local
#
# This is the "local" profile's single source of truth — the same role
# env/.env.vm / env/.env.acg / env/.env.prod play for the other three profiles.
# Consumed by compose/docker-compose-local.yml and each project's dev-up.sh.

# eventstracker
EVENTS_TRACKER_DB_NAME=event-service
EVENTS_TRACKER_DB_USER=CHANGE_ME
EVENTS_TRACKER_DB_PASSWORD=CHANGE_ME

# runs-app
RUNS_APP_DB_NAME=runsapp_db
RUNS_APP_DB_USER=CHANGE_ME
RUNS_APP_DB_PASSWORD=CHANGE_ME

# runs-ai-analyzer
RUNS_AI_ANALYZER_DB_NAME=runs_ai_analyzer_db
RUNS_AI_ANALYZER_DB_USER=CHANGE_ME
RUNS_AI_ANALYZER_DB_PASSWORD=CHANGE_ME

# mytracker
MYTRACKER_DB_NAME=postgres
MYTRACKER_DB_USER=CHANGE_ME
MYTRACKER_DB_PASSWORD=CHANGE_ME

# RabbitMQ (shared broker)
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# eventstracker app-level secrets (read by eventstracker/dev-up.sh)
EVENT_DOMAIN_USER=CHANGE_ME
EVENT_DOMAIN_USER_PASSWORD=CHANGE_ME
