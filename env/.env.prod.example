# Prod environment (DigitalOcean, persistent) — generated by
# scripts/prod/prod-start.sh, not normally hand-filled.
#
# NOTE: this is a separate file from env/.env.acg — prod and the ACG
# sandboxes used to share one file (env/.env.cloud), which meant whichever
# one ran most recently silently overwrote the other's credentials. Keep
# them separate.
#
# "prod" is persistent by design: scripts/prod/prod-stop.sh backs up on
# every run but only destroys infrastructure when you pass --destroy.
#
# Per-project keys below use the SAME names as project-config.sh's
# get_project_db_url_key / get_project_db_user_env_key / get_project_env_password_key
# — the "domain A" keys each project's own .env / dev-up.sh --prod expects.

# ── DigitalOcean PostgreSQL Details ─────────────────────────────────────
DB_HOST=CHANGE_ME
DB_PORT=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ── eventstracker ────────────────────────────────────────────────────────
EVENTS_TRACKER_DB_URL=CHANGE_ME
EVENTS_TRACKER_DB_USER=CHANGE_ME
EVENTS_TRACKER_DB_PASSWORD=CHANGE_ME

# ── runs-app ─────────────────────────────────────────────────────────────
JDBC_DATABASE_URL=CHANGE_ME
JDBC_DATABASE_USERNAME=CHANGE_ME
JDBC_DATABASE_PASSWORD=CHANGE_ME

# ── runs-ai-analyzer ─────────────────────────────────────────────────────
RUNS_AI_ANALYZER_DB_URL=CHANGE_ME
RUNS_AI_ANALYZER_DB_USER=CHANGE_ME
RUNS_AI_ANALYZER_DB_PASSWORD=CHANGE_ME

# ── RabbitMQ (set explicitly if using a managed broker) ─────────────────
# RABBITMQ_HOST=
# RABBITMQ_PORT=
# RABBITMQ_USERNAME=
# RABBITMQ_PASSWORD=
