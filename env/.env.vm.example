# Portainer stack environment variables for docker-compose-vm.yml
#
# Copy to .env.vm (gitignored) and fill in real values:
#   cp .env.vm.example .env.vm
#
# This file is the BASE environment pushed to the Portainer stack by
# scripts/vm/vm-db-up.sh. Database credentials listed below are normally
# overwritten by values from each project's local .env, but every key
# must be present for a standalone Portainer deployment.
#
# ── Spring Cloud Config server ─────────────────────────────────────────────
GIT_URI=https://github.com/sathishjayapal/jubilant-memory
ENCRYPT_KEY=CHANGE_ME
CONFIG_SERVER_USERNAME=cfg_local
CONFIG_SERVER_PASSWORD=CHANGE_ME

# ── RabbitMQ broker ────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=sathish
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ── Docker Hub token for Watchtower image polling ────────────────────────────
DOCKERHUB_TOKEN=CHANGE_ME

# ── Initial event-domain user for eventstracker seeding ──────────────────────
EVENT_DOMAIN_USER=eventdomain_local
EVENT_DOMAIN_USER_PASSWORD=CHANGE_ME

# ── Project databases (eventstracker is always required) ───────────────────
# NOTE: vm-db-up.sh replaces these with values from each project's local .env.
#       Keep them as safe fallbacks / placeholders.

# eventstracker DB
EVENTS_TRACKER_DB_NAME=event-service
EVENTS_TRACKER_DB_USER=eventstracker_local
EVENTS_TRACKER_DB_PASSWORD=CHANGE_ME

# runs-app DB
RUNS_APP_DB_NAME=runsapp_db
RUNS_APP_DB_USER=runsapp_local
RUNS_APP_DB_PASSWORD=CHANGE_ME

# runs-ai-analyzer DB
RUNS_AI_ANALYZER_DB_NAME=runs_ai_analyzer_db
RUNS_AI_ANALYZER_DB_USER=runsai_local
RUNS_AI_ANALYZER_DB_PASSWORD=CHANGE_ME

# ── Diagram Maker Integration ─────────────────────────────────────────────────
RUNS_AI_ANALYZER_BASE_URL=http://runs-ai-analyzer:8081
DIAGRAM_MAKER_BASE_URL=http://diagram-maker:8091
DIAGRAM_MAKER_MCP_ENABLED=true

# verbose-barnacle (github cleaner) DB
GITHUB_CLEANER_DB_NAME=my-github-cleaner
GITHUB_CLEANER_DB_USER=githubcleaner_local
GITHUB_CLEANER_DB_PASSWORD=CHANGE_ME

# dbcleaner DB
DBCLEANER_DB_NAME=dbcleaner
DBCLEANER_DB_USER=dbcleaner_local
DBCLEANER_DB_PASSWORD=CHANGE_ME

SATHISHLOGGER_DB_NAME=sathishlogger
SATHISHLOGGER_DB_USER=sathishlogger
SATHISHLOGGER_DB_PASSWORD=CHANGE_ME

# ── Garmin Import Configuration ────────────────────────────────────────────────
GARMIN_SYSTEM_USER_ID=10092
GARMIN_CSV_IMPORT_SCHEDULE=0 */5 * * * *
GARMIN_CSV_IMPORT_ENABLED=true

# ── SMTP Configuration ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=CHANGE_ME

MAIL_FROM=noreply@example.com
MAIL_DISPLAY_NAME=Runs App

# ── Garmin CSV Import Alert Configuration ──────────────────────────────────────
GARMIN_ALERT_EMAIL_ENABLED=true
GARMIN_ALERT_EMAIL_MAX_RETRY_ATTEMPTS=3
GARMIN_ALERT_EMAIL_RECIPIENTS=admin@example.com,devops@example.com
GARMIN_ALERT_EMAIL_FROM=garmin-import@example.com

# ── Google Drive Configuration (for Garmin data) ───────────────────────────────
# Folder IDs for organizing imported Garmin files
GARMIN_DRIVE_FOLDER_ID=CHANGE_ME
GARMIN_DRIVE_PROCESSED_FOLDER_ID=CHANGE_ME
GARMIN_DRIVE_QUARANTINE_FOLDER_ID=CHANGE_ME
GARMIN_DRIVE_FAILED_FOLDER_ID=CHANGE_ME
GARMIN_DRIVE_RETRY_FOLDER_ID=CHANGE_ME

# Service account credentials (base64 encoded JSON from Google Cloud)
# To encode: base64 < /path/to/credentials.json | tr -d '\n'
GARMIN_DRIVE_SERVICE_ACCOUNT_KEY_BASE64=CHANGE_ME

# Path where credentials will be decoded inside container (do not change)
GARMIN_DRIVE_SERVICE_ACCOUNT_KEY_PATH=/app/credentials/google-drive.json

# ── Sample Data Initialization (Dev Only) ──────────────────────────────────────
# IMPORTANT: Set to 'false' for production environments
APP_INITIALIZATION_ENABLE_SAMPLE_DATA=false
APP_INITIALIZATION_ADMIN_EMAIL=admin@runsapp.com
APP_INITIALIZATION_ADMIN_PASSWORD=CHANGE_ME
APP_INITIALIZATION_USER_EMAIL=runner@runsapp.com
APP_INITIALIZATION_USER_PASSWORD=CHANGE_ME
APP_INITIALIZATION_SYSTEM_EMAIL=system@runsapp.com
APP_INITIALIZATION_SYSTEM_PASSWORD=CHANGE_ME

# ── Production Settings ────────────────────────────────────────────────────────
PRODUCTION=false
API_PATH=
