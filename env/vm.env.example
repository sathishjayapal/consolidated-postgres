# VirtualBox VM / Portainer connection settings for scripts/vm/vm-db-up.sh
#
# Copy to vm.env (gitignored) and fill in real values:
#   cp vm.env.example vm.env

# LAN IP of the VirtualBox VM (bridged adapter) — run `hostname -I` inside the VM
VM_IP=192.168.4.94

# Portainer running inside the VM
PORTAINER_URL=http://${VM_IP}:9443

# Portainer API key: Portainer UI → user icon (top right) → My account → Access tokens → Add access token
PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint (environment) ID of the VM's local Docker in Portainer.
# Usually 1 or 2 — check the number in the URL when you click the environment
# in Portainer (…/#!/2/docker/dashboard → ID is 2), or run:
#   curl -s -H "X-API-Key: $PORTAINER_API_KEY" $PORTAINER_URL/api/endpoints | jq '.[] | {Id, Name}'
PORTAINER_ENDPOINT_ID=2

# Name of the Portainer stack that holds the databases
PORTAINER_STACK_NAME=sathish-stack
