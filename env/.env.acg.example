# ACG sandbox environment — shared by both ACG backends:
#   scripts/acg/acg-start.sh      (Azure PostgreSQL Flexible Server)
#   scripts/acg/acg-aws-start.sh  (native Postgres on EC2, via SSM tunnel)
#
# Copy to .env.acg (gitignored) — normally you don't hand-fill this, one of
# the two acg-*-start.sh scripts generates it for you. This file documents
# what ends up in it.
#
# NOTE: this is a separate file from env/.env.prod — ACG (temporary sandbox)
# and prod (persistent DigitalOcean) used to share one file (env/.env.cloud),
# which meant running either one silently clobbered the other's credentials.
# Keep them separate.
#
# Per-project keys below use the SAME names as project-config.sh's
# get_project_db_url_key / get_project_db_user_env_key / get_project_env_password_key
# — the "domain A" keys each project's own .env / dev-up.sh --acg expects.

# ── Shared connection info ──────────────────────────────────────────────────
DB_HOST=CHANGE_ME
DB_PORT=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ── AWS ACG only — SSM tunnel info (blank/unused for Azure ACG) ────────────
SSM_RELAY_INSTANCE_ID=
SSM_TUNNEL_PORT=
SECRET_ARN=

# ── eventstracker ────────────────────────────────────────────────────────
EVENTS_TRACKER_DB_URL=CHANGE_ME
EVENTS_TRACKER_DB_USER=CHANGE_ME
EVENTS_TRACKER_DB_PASSWORD=CHANGE_ME

# ── runs-app ─────────────────────────────────────────────────────────────
JDBC_DATABASE_URL=CHANGE_ME
JDBC_DATABASE_USERNAME=CHANGE_ME
JDBC_DATABASE_PASSWORD=CHANGE_ME

# ── runs-ai-analyzer ─────────────────────────────────────────────────────
RUNS_AI_ANALYZER_DB_URL=CHANGE_ME
RUNS_AI_ANALYZER_DB_USER=CHANGE_ME
RUNS_AI_ANALYZER_DB_PASSWORD=CHANGE_ME

# ── verbose-barnacle (github cleaner) ────────────────────────────────────
GITHUB_CLEANER_DB_URL=CHANGE_ME
GITHUB_CLEANER_DB_USER=CHANGE_ME
GITHUB_CLEANER_DB_PASSWORD=CHANGE_ME

# ── dbcleaner ────────────────────────────────────────────────────────────
DBCLEANER_DB_URL=CHANGE_ME
DBCLEANER_DB_USER=CHANGE_ME
DBCLEANER_DB_PASSWORD=CHANGE_ME
